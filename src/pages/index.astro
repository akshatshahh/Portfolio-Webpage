---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import CodeIcon from "@/components/icons/Code.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import Experience from "@/components/Experience.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import FeaturedProjects from "@/components/FeaturedProjects.astro"
import MoreProjects from "@/components/MoreProjects.astro"
import OpenSource from "@/components/OpenSource.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
import Education from "@/components/Education.astro"
import EducationHat from "@/components/icons/EducationHat.astro"
import Chatbot from "@/components/Chatbot.astro"

const headingClass = "flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
---

<Layout
  title="Akshat Shah · Software Engineer"
  description="Akshat Shah is a full stack and backend software engineer (MS CS, USC 2026) building FastAPI, Node and React systems and contributing to open source AI infrastructure."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero />
    </SectionContainer>
    <div class="space-y-24">
      <SectionContainer id="projects">
        <h2 class={headingClass}>
          <CodeIcon class="size-7" />
          Featured Projects
        </h2>
        <FeaturedProjects />
      </SectionContainer>

      <SectionContainer id="experience">
        <h2 class={headingClass}>
          <Briefcase class="size-8" />
          Experience
        </h2>
        <Experience />
      </SectionContainer>

      <SectionContainer id="open-source">
        <h2 class={headingClass}>
          <GitHubIcon class="size-8" />
          Open Source
        </h2>
        <OpenSource />
      </SectionContainer>

      <SectionContainer id="more-projects">
        <h2 class={headingClass}>
          <CodeIcon class="size-7" />
          More Projects
        </h2>
        <MoreProjects />
      </SectionContainer>

      <SectionContainer id="education">
        <h2 class={headingClass}>
          <EducationHat class="size-8" />
          Education
        </h2>
        <Education />
      </SectionContainer>

      <SectionContainer id="about-me">
        <h2 class={headingClass}>
          <ProfileCheck class="size-8" />
          About Me
        </h2>
        <AboutMe />
      </SectionContainer>
    </div>
  </main>
  <Chatbot />
</Layout>

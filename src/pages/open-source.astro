---
import Layout from "@/layouts/Layout.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import OpenSourceList from "@/components/OpenSource.astro"
---

<Layout
  title="Open Source · Akshat Shah"
  description="Pull requests Akshat Shah has shipped to open source projects, and releases that credit his work."
>
  <main class="px-4 pt-28 pb-16">
    <SectionContainer id="open-source">
      <a href="/" class="text-sm text-gray-600 hover:text-yellow-700 dark:text-gray-400 dark:hover:text-yellow-300">← Back to home</a>
      <h1 class="mt-4 mb-6 text-4xl font-bold tracking-tight text-gray-900 dark:text-white">Open Source</h1>
      <OpenSourceList variant="full" />
    </SectionContainer>
  </main>
</Layout>

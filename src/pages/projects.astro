---
import Layout from "@/layouts/Layout.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import FeaturedProjects from "@/components/FeaturedProjects.astro"
import MoreProjects from "@/components/MoreProjects.astro"
---

<Layout
  title="Projects · Akshat Shah"
  description="Case studies and side projects by Akshat Shah: backend services, full stack apps and local-first AI tools."
>
  <main class="px-4 pt-28 pb-16">
    <SectionContainer id="projects">
      <a href="/" class="text-sm text-gray-600 hover:text-yellow-700 dark:text-gray-400 dark:hover:text-yellow-300">← Back to home</a>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900 dark:text-white">Projects</h1>
      <p class="mt-3 max-w-2xl text-gray-700 dark:text-gray-300">
        Three case studies with architecture and design decisions, then everything else I have built. Private repos are
        available for a walkthrough on request.
      </p>
      <h2 class="mt-10 mb-4 text-2xl font-semibold text-gray-900 dark:text-white">Case studies</h2>
      <FeaturedProjects />
      <h2 class="mt-14 mb-4 text-2xl font-semibold text-gray-900 dark:text-white">More projects</h2>
      <MoreProjects />
    </SectionContainer>
  </main>
</Layout>

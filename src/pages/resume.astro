---
import Layout from "@/layouts/Layout.astro"
import { RESUME } from "@/data/resume"

const PDF = "/Akshat-Shah-Resume.pdf"
---

<Layout
  title="Resume · Akshat Shah, Software Engineer & AI Engineer"
  description="Resume of Akshat Shah: Software Engineer at USC IMSC, former Software Engineer Intern at Microsoft, MS in Computer Science from USC (2026). Python, FastAPI, React, PostgreSQL, LLMs. Los Angeles, open to relocation."
>
  <main class="px-4 py-28">
    <div class="container mx-auto md:max-w-3xl lg:max-w-4xl">
      <a href="/" class="text-sm text-gray-500 hover:text-yellow-500 dark:text-gray-400">← Back to portfolio</a>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-4xl font-bold tracking-tight text-gray-800 dark:text-white">Resume</h1>
        <a
          href={PDF}
          download
          class="inline-flex items-center gap-2 rounded-xl bg-yellow-400 px-4 py-2 font-medium text-black transition hover:bg-yellow-300"
        >
          Download PDF
        </a>
      </div>
      <a href={PDF} target="_blank" rel="noopener noreferrer" class="mt-8 block" aria-label="Open the resume PDF">
        <img
          src="/resume-preview.webp"
          width="1700"
          height="2200"
          alt="Resume of Akshat Shah: Software Engineer at USC IMSC, former Software Engineer Intern at Microsoft, MS CS at USC."
          class="w-full rounded-xl border border-gray-200 bg-white shadow-xl dark:border-gray-800"
        />
      </a>
      <p class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400">
        Click the page to open the PDF with working links.
      </p>

      <details class="mt-8 rounded-xl border border-gray-200 bg-white/70 p-5 dark:border-white/10 dark:bg-gray-900/70">
        <summary class="cursor-pointer font-semibold text-gray-900 dark:text-white">Read the resume as text</summary>
        <article data-testid="resume-text" class="mt-4 space-y-6 text-sm text-gray-700 dark:text-gray-300">
          <header>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">{RESUME.name}</h2>
            <p>{RESUME.tagline}</p>
            <p>{RESUME.contact}</p>
          </header>
          {
            RESUME.sections.map((section) => (
              <section>
                <h3 class="border-b border-gray-200 pb-1 text-base font-semibold text-gray-900 dark:border-white/10 dark:text-white">
                  {section.heading}
                </h3>
                {section.entries.map((entry) => (
                  <div class="mt-3">
                    {entry.title && (
                      <p class="flex flex-wrap justify-between gap-x-4 font-medium text-gray-900 dark:text-gray-100">
                        <span>{entry.title}</span>
                        {entry.date && <span class="text-gray-600 dark:text-gray-400">{entry.date}</span>}
                      </p>
                    )}
                    {entry.meta && <p class="italic">{entry.meta}</p>}
                    <ul class="mt-1 list-disc space-y-1 pl-5">
                      {entry.points.map((point) => <li>{point}</li>)}
                    </ul>
                  </div>
                ))}
              </section>
            ))
          }
        </article>
      </details>
    </div>
  </main>
</Layout>

---
import ExperienceItem from "./ExperienceItem.astro"
const EXPERIENCIE = [
  {
    company: "Integrated Media Systems Center (IMSC) @ USC",
    roles: [
      { title: "Software Engineer", type: "Full-time", start: "2026-08" },
      {
        title: "Graduate Research Assistant",
        type: "Part-time",
        start: "2025-03",
        end: "2026-08",
        summary: "Built the POI Game, a crowdsourced web platform that generates labeled training data for ML location-attribution models.",
      },
    ],
    points: [
      "Design and deploy async Python FastAPI microservices powering a real-time geospatial platform for 500+ daily active users, cutting average endpoint latency by 35% over a synchronous baseline",
      "Integrate Google OAuth 2.0 and JWT authentication across the microservices with structured error handling, securing every REST endpoint with zero reported authentication failures",
      "Optimize PostgreSQL 16 PostGIS spatial indexes and H3 geospatial indexing to reduce query latency by 40%, supporting reliable ingestion of 10k+ daily user submissions into partitioned tables without dropped writes",
    ],
  },
  {
    company: "USC Viterbi K-12 STEM Center",
    roles: [{ title: "Lead Teaching Assistant", start: "2025-04", end: "2025-07" }],
    points: [
      "Directed a team of 8 teaching assistants delivering a month-long, 3-unit engineering course on algorithms, data structures and software engineering principles to 60+ students, earning a 95% positive feedback rating",
    ],
  },
  {
    company: "Microsoft, Hyderabad, India",
    roles: [{ title: "Software Engineer Intern", type: "Internship", start: "2023-06", end: "2023-07" }],
    points: [
      "Built KQL and Azure Data Explorer dashboards tracking end-to-end latency for Word, Excel and PowerPoint across browser and Teams surfaces, giving production observability for a platform serving 85M+ monthly active users",
      "Reduced manual performance monitoring overhead by 60% with automated monitoring pipelines in CI/CD that evaluated latency thresholds and flagged regressions across production environments daily",
      "Delivered 8 dashboards with P50 / P75 / P95 percentile views, component-level latency breakdowns and farm comparisons, helping engineers find concurrency bottlenecks and scalability regressions toward a sub-5-second document load target",
    ],
  },
]
---

<ol class="relative mt-16 md:before:absolute md:before:left-1/2 md:before:top-0 md:before:h-full md:before:w-px md:before:bg-gray-300 md:dark:before:bg-white/15">
  {
    EXPERIENCIE.map((experiencie, index) => (
      <ExperienceItem {...experiencie} side={index % 2 === 0 ? 'left' : 'right'} />
    ))
  }
</ol>

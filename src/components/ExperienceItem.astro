---
import { formatDuration, formatRange } from "@/lib/dates"

export interface Role {
  title: string
  type?: string
  start: string
  end?: string
  summary?: string
}

interface Props {
  company: string
  roles: Role[]
  points: string[]
}

const { company, roles, points } = Astro.props
const grouped = roles.length > 1
// Roles are listed newest first, so the group spans from the last role's start to the first role's end.
const groupStart = roles[roles.length - 1].start
const groupEnd = roles[0].end
---

<li class="relative pl-6 sm:pl-8">
  <span
    class="absolute -left-[9px] top-6 size-4 rounded-full border-4 border-gray-50 bg-yellow-500 dark:border-gray-950 dark:bg-yellow-400"
    aria-hidden="true"
  ></span>
  <div
    class="grid gap-x-8 gap-y-4 rounded-xl border border-gray-200 bg-white/70 p-5 shadow-sm dark:border-white/10 dark:bg-gray-900/70 lg:grid-cols-[minmax(0,320px)_1fr]"
  >
    <div>
      {
        grouped ? (
          <>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{company}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">{formatDuration(groupStart, groupEnd)}</p>
            <ol class="mt-3 space-y-3 border-l-2 border-yellow-500/50 pl-3">
              {roles.map((role) => (
                <li>
                  <h4 class="font-bold text-yellow-700 dark:text-yellow-400">{role.title}</h4>
                  <p class="text-sm text-gray-600 dark:text-gray-400">
                    {role.type && <>{role.type} · </>}
                    {formatRange(role.start, role.end)} · {formatDuration(role.start, role.end)}
                  </p>
                  {role.summary && <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">{role.summary}</p>}
                </li>
              ))}
            </ol>
          </>
        ) : (
          <>
            <h3 class="text-lg font-bold text-yellow-700 dark:text-yellow-400">{roles[0].title}</h3>
            <p class="font-semibold text-gray-900 dark:text-white">{company}</p>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              {roles[0].type && <>{roles[0].type} · </>}
              {formatRange(roles[0].start, roles[0].end)} · {formatDuration(roles[0].start, roles[0].end)}
            </p>
          </>
        )
      }
    </div>
    <ul class="space-y-2 text-gray-700 dark:text-gray-300">
      {
        points.map((point) => (
          <li class="flex gap-2">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-yellow-500 dark:bg-yellow-400" />
            <span>{point}</span>
          </li>
        ))
      }
    </ul>
  </div>
</li>

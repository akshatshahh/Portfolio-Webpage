---
import { formatDuration, formatRange } from "@/lib/dates"

export interface Role {
  title: string
  type?: string
  start: string
  end?: string
  summary?: string
}

interface Props {
  company: string
  roles: Role[]
  points: string[]
  side: 'left' | 'right'
}

const { company, roles, points, side } = Astro.props
const grouped = roles.length > 1
// Roles are listed newest first, so the group spans from the last role's start to the first role's end.
const groupStart = roles[roles.length - 1].start
const groupEnd = roles[0].end
---

<li data-side={side} class={`group relative pb-16 md:w-1/2 ${side === 'right' ? 'md:ml-auto md:pl-8' : 'md:pr-8'}` }>
  <span class="absolute left-1/2 -translate-x-1/2 top-0 w-3 h-3 rounded-full bg-yellow-400"></span>
  <div class="experience-card bg-white/60 dark:bg-gray-800/60 backdrop-blur rounded-md p-4 shadow transform-gpu transition-transform duration-500">
    {
      grouped ? (
        <>
          <h3 class="font-semibold text-xl text-gray-700 dark:text-white">{company}</h3>
          <p class="text-sm text-gray-600/80 dark:text-white/70">{formatDuration(groupStart, groupEnd)}</p>
          <ol class="mt-4 space-y-4 border-l border-yellow-400/40 pl-4">
            {roles.map((role) => (
              <li class="relative">
                <span class="absolute -left-[21px] top-2 size-2.5 rounded-full bg-yellow-400" />
                <h4 class="text-lg font-bold text-yellow-400">{role.title}</h4>
                {role.type && <p class="text-sm text-gray-600 dark:text-gray-300">{role.type}</p>}
                <time class="text-sm text-gray-600/80 dark:text-white/70">
                  {formatRange(role.start, role.end)} · {formatDuration(role.start, role.end)}
                </time>
                {role.summary && <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">{role.summary}</p>}
              </li>
            ))}
          </ol>
        </>
      ) : (
        <>
          <h3 class="text-xl font-bold text-yellow-400">{roles[0].title}</h3>
          <h4 class="font-semibold text-xl text-gray-600 dark:text-white">{company}</h4>
          <time class="text-sm text-gray-600/80 dark:text-white/80">
            {formatRange(roles[0].start, roles[0].end)} · {formatDuration(roles[0].start, roles[0].end)}
          </time>
        </>
      )
    }
    <ul class="mt-3 space-y-2 text-gray-600 dark:text-gray-300">
      {
        points.map((point) => (
          <li class="flex gap-2">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-yellow-400" />
            <span>{point}</span>
          </li>
        ))
      }
    </ul>
  </div>
</li>

<style is:global>
  li[data-side="left"].group:hover .experience-card {
    transform: perspective(800px) rotateY(-15deg);
  }
  li[data-side="right"].group:hover .experience-card {
    transform: perspective(800px) rotateY(15deg);
  }
  @media (prefers-reduced-motion: reduce) {
    li.group:hover .experience-card {
      transform: none;
    }
  }
</style>

---
import type { Tag } from "@/data/tags"

interface Props {
  tags: Tag[]
}

const { tags } = Astro.props
---

<ul class="flex flex-wrap gap-2">
  {
    tags.map((tag) => (
      <li>
        <span class="inline-flex items-center gap-1.5 rounded-md border border-gray-300 bg-white px-2 py-1 text-xs font-medium text-gray-700 dark:border-white/15 dark:bg-white/5 dark:text-gray-200">
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="size-3.5 shrink-0 fill-[var(--icon-light)] dark:fill-[var(--icon-dark)]"
            style={`--icon-light:${tag.light};--icon-dark:${tag.dark}`}
          >
            <path d={tag.path} />
          </svg>
          {tag.name}
        </span>
      </li>
    ))
  }
</ul>

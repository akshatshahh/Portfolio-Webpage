---
const EDUCATION = [
  {
    date: "2024 - May 2026",
    degree: "MS, Computer Science",
    institution: "University of Southern California, Viterbi School of Engineering",
    grade: "3.55 GPA",
    courses:
      "Analysis of Algorithms, Database Systems, Software Architectures, Web Technologies, Applied Cryptography, Applied NLP, Information Retrieval and Web Search Engines",
  },
  {
    date: "2020 - 2024",
    degree: "BTech, Computer Science and Engineering",
    institution: "Indus University, Ahmedabad",
    grade: "3.86 GPA",
    courses: "Data Structures, Algorithms, Machine Learning, Web Development, Operating Systems",
  },
]
---

<ul class="space-y-6">
  {
    EDUCATION.map((e) => (
      <li class="rounded-xl border border-gray-200 bg-white/60 p-5 dark:border-gray-800 dark:bg-gray-900/60">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-lg font-bold text-yellow-500 dark:text-yellow-400">{e.degree}</h3>
          <span class="text-sm text-gray-500 dark:text-gray-400">
            {e.date} · {e.grade}
          </span>
        </div>
        <p class="font-medium text-gray-700 dark:text-gray-200">{e.institution}</p>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{e.courses}</p>
      </li>
    ))
  }
</ul>

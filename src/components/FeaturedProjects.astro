---
import { FEATURED_PROJECTS } from "@/data/projects"
import TagList from "./TagList.astro"
import ActionLink from "./ActionLink.astro"
import Screenshot from "./Screenshot.astro"
import GitHub from "./icons/GitHub.astro"
import ArrowUpRight from "./icons/ArrowUpRight.astro"
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {
    FEATURED_PROJECTS.map((project) => (
      <article class="flex flex-col rounded-xl border border-gray-200 bg-white/70 p-4 shadow-sm transition hover:shadow-lg dark:border-white/10 dark:bg-gray-900/70">
        <a href={`/projects/${project.slug}`} aria-label={`${project.title} case study`}>
          <Screenshot src={project.image} alt={`Screenshot of ${project.title}`} />
        </a>
        <div class="mt-4 flex flex-1 flex-col">
          <div class="flex flex-wrap items-baseline justify-between gap-x-2">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">
              <a href={`/projects/${project.slug}`} class="hover:text-yellow-700 dark:hover:text-yellow-300">
                {project.title}
              </a>
            </h3>
            <span class="text-sm text-gray-600 dark:text-gray-400">{project.period}</span>
          </div>
          <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">{project.context}</p>
          <p class="mt-3 flex-1 text-gray-800 dark:text-gray-200">{project.tagline}</p>
          <div class="mt-4">
            <TagList tags={project.tags.slice(0, 4)} />
          </div>
          <footer class="mt-5 flex flex-wrap items-center gap-2">
            <ActionLink href={`/projects/${project.slug}`} variant="primary">
              Case study
            </ActionLink>
            {project.live && (
              <ActionLink href={project.live}>
                Live
                <ArrowUpRight class="size-4" />
              </ActionLink>
            )}
            {project.github && (
              <ActionLink href={project.github}>
                <GitHub class="size-4" />
                Code
              </ActionLink>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>

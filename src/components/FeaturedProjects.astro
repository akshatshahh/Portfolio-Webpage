---
import { FEATURED_PROJECTS } from "@/data/projects"
import TagList from "./TagList.astro"
import ActionLink from "./ActionLink.astro"
import Screenshot from "./Screenshot.astro"
import GitHub from "./icons/GitHub.astro"
import ArrowUpRight from "./icons/ArrowUpRight.astro"
---

<div class="flex flex-col gap-y-12">
  {
    FEATURED_PROJECTS.map((project) => (
      <article class="overflow-hidden rounded-xl border border-gray-200 bg-white/70 shadow-sm dark:border-white/10 dark:bg-gray-900/70">
        <a href={`/projects/${project.slug}`} class="block p-4 pb-0 sm:p-6 sm:pb-0" aria-label={`${project.title} case study`}>
          <Screenshot src={project.image} alt={`Screenshot of ${project.title}`} class="transition hover:shadow-lg" />
        </a>
        <div class="p-4 sm:p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
              <a href={`/projects/${project.slug}`} class="hover:text-yellow-600 dark:hover:text-yellow-300">
                {project.title}
              </a>
            </h3>
            <span class="text-sm text-gray-600 dark:text-gray-400">{project.period}</span>
          </div>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{project.context}</p>
          <p class="mt-3 text-lg text-gray-800 dark:text-gray-200">{project.tagline}</p>
          <div class="mt-4">
            <TagList tags={project.tags} />
          </div>
          <ul class="mt-4 space-y-2 text-gray-700 dark:text-gray-300">
            {project.highlights.map((h) => (
              <li class="flex gap-2">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-yellow-500 dark:bg-yellow-400" />
                <span>{h}</span>
              </li>
            ))}
          </ul>
          <footer class="mt-6 flex flex-wrap items-center gap-3">
            <ActionLink href={`/projects/${project.slug}`} variant="primary">
              Read the case study
            </ActionLink>
            {project.live && (
              <ActionLink href={project.live}>
                Live demo
                <ArrowUpRight class="size-4" />
              </ActionLink>
            )}
            {project.github && (
              <ActionLink href={project.github}>
                <GitHub class="size-4" />
                Source code
              </ActionLink>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>

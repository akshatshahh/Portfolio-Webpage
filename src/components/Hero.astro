---
const personalImageAlt = "Akshat Shah"
import Badge from "@/components/Badge.astro"
import ActionLink from "@/components/ActionLink.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import GithubIcon from "@/components/icons/GitHub.astro"
import SocialPill from "@/components/SocialPill.astro"
import TagList from "@/components/TagList.astro"
import { TAGS } from "@/data/tags"
import { getContributions, type OpenSourceData } from "@/lib/openSource"
import snapshot from "@/data/open-source-snapshot.json"

const { contributions } = await getContributions(snapshot as OpenSourceData)
const shippedCount = contributions.filter((c) => c.state === "merged").length

const GLANCE = [
  { label: "Based in", value: "Los Angeles, CA" },
  { label: "Relocation", value: "Open to anywhere in the US" },
  { label: "Now", value: "Software Engineer, USC IMSC" },
  { label: "Before", value: "Software Engineer Intern, Microsoft" },
  { label: "Education", value: "MS Computer Science, USC (2026)" },
  { label: "Looking for", value: "Software, Backend and Full Stack Engineer roles" },
]
const CORE_STACK = [TAGS.PYTHON, TAGS.TYPESCRIPT, TAGS.FASTAPI, TAGS.REACT, TAGS.POSTGRES, TAGS.DOCKER]
---

<div class="grid items-start gap-10 lg:grid-cols-[1fr_360px]">
  <div>
    <div class="flex gap-4 mb-4">
      <img
        class="rounded-full shadow-lg size-16"
        src="/profile-pic.png"
        alt={personalImageAlt}
      />
      <a
        href="https://linkedin.com/in/akshatshahh"
        target="_blank"
        rel="noopener"
        class="flex items-center transition md:justify-center md:hover:scale-105"
      >
        <Badge>Software Engineer @ USC IMSC</Badge>
      </a>
    </div>
    <h1
      class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
    >
    Hey, I'm Akshat Shah
    </h1>
    <p class="mt-3 text-lg font-medium text-gray-600 dark:text-gray-400">
      Backend and full stack engineer · MS CS, USC (2026)
    </p>
    <p class="mt-2 flex items-start gap-1.5 text-gray-600 dark:text-gray-400">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="mt-1 size-4 shrink-0 fill-current">
        <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7m0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5" />
      </svg>
      <span>Based in Los Angeles, CA · Open to relocating anywhere in the US</span>
    </p>
    <p
      class="mt-6 max-w-2xl text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-700 [&>strong]:font-semibold dark:text-gray-300"
    >
      I build backend systems that hold up in production. At <strong>USC IMSC</strong> I design async FastAPI
      microservices for a real-time geospatial platform used by <strong>500+ people</strong>, and cut query
      latency 40% with PostGIS and H3 indexing. At <strong>Microsoft</strong> I built latency observability for Office
      apps serving <strong>85M+ users</strong>. I also contribute upstream, with
      <strong>{shippedCount} pull requests shipped</strong> in projects like Microsoft PyRIT, OpenClaw and reticle.
    </p>
    <nav class="flex flex-wrap gap-4 mt-8" aria-label="Contact links">
      <SocialPill href="mailto:akshatshahh2003@gmail.com">
        <MailIcon class="size-4" />
        Contact me
      </SocialPill>
      <SocialPill href="https://linkedin.com/in/akshatshahh">
        <LinkedInIcon class="size-4" />
        LinkedIn
      </SocialPill>
      <SocialPill href="https://github.com/akshatshahh">
        <GithubIcon class="size-4" />
        GitHub
      </SocialPill>
    </nav>
  </div>

  <aside
    aria-label="At a glance"
    class="rounded-xl border border-gray-200 bg-white/80 p-5 shadow-sm dark:border-white/10 dark:bg-gray-900/70"
  >
    <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400">
      <span class="size-2 rounded-full bg-green-500" aria-hidden="true"></span>
      At a glance · open to work
    </h2>
    <dl class="mt-4 space-y-3 text-sm">
      {
        GLANCE.map((item) => (
          <div class="grid grid-cols-[96px_1fr] gap-2">
            <dt class="text-gray-600 dark:text-gray-400">{item.label}</dt>
            <dd class="font-medium text-gray-900 dark:text-gray-100">{item.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="mt-4 border-t border-gray-200 pt-4 dark:border-white/10">
      <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400">Core stack</p>
      <TagList tags={CORE_STACK} />
    </div>
    <div class="mt-5 flex flex-wrap gap-2">
      <ActionLink href="/resume" variant="primary">View resume</ActionLink>
      <ActionLink href="mailto:akshatshahh2003@gmail.com" external={false}>Email me</ActionLink>
    </div>
  </aside>
</div>

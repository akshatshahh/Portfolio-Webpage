---
const personalImageAlt = "Akshat Shah"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import GithubIcon from "@/components/icons/GitHub.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/profile-pic.png"
      alt={personalImageAlt}
    />
    <a
      href="https://linkedin.com/in/akshatshahh"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Open to work · Will relocate</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
  Hey, I'm Akshat Shah
  </h1>
  <p class="mt-3 text-lg font-medium text-gray-600 dark:text-gray-400">
    Software Engineer · MS CS, University of Southern California (May 2026)
  </p>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    I build <strong>full stack and backend systems</strong>: FastAPI and Node services, React frontends,
    Postgres, and LLM-powered tools that run locally. I'm a Software Engineer at USC IMSC and contribute fixes
    upstream to open source projects like <strong>Microsoft PyRIT</strong> and <strong>LiteLLM</strong>.
    Looking for Software Engineer, Backend and Full Stack roles.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:akshatshahh2003@gmail.com">
      <MailIcon class="size-4" />
      Contact me
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/akshatshahh">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/akshatshahh">
      <GithubIcon class="size-4" />
      GitHub
    </SocialPill>
    <SocialPill href="https://drive.google.com/file/d/1c0uyfFN7FVQz53iAZzfM9mnT2Q4cBfhF/view?usp=sharing">
      Resume
    </SocialPill>
  </nav>
</div>

---
const personalImageAlt = "Akshat Shah"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import GithubIcon from "@/components/icons/GitHub.astro"
import SocialPill from "@/components/SocialPill.astro"
import { getContributions, type OpenSourceData } from "@/lib/openSource"
import snapshot from "@/data/open-source-snapshot.json"

const { contributions } = await getContributions(snapshot as OpenSourceData)
const mergedCount = contributions.filter((c) => c.state === "merged").length
---

<div class="max-w-2xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/profile-pic.png"
      alt={personalImageAlt}
    />
    <a
      href="https://linkedin.com/in/akshatshahh"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Software Engineer @ USC IMSC</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
  Hey, I'm Akshat Shah
  </h1>
  <p class="mt-3 text-lg font-medium text-gray-600 dark:text-gray-400">
    Backend and full stack engineer · MS CS, University of Southern California (2026)
  </p>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    I build backend systems that hold up in production. At <strong>USC IMSC</strong> I design async FastAPI
    microservices for a real-time geospatial platform used by <strong>500+ people a day</strong>, and cut query
    latency 40% with PostGIS and H3 indexing. At <strong>Microsoft</strong> I built latency observability for Office
    apps serving <strong>85M+ users</strong>. I also ship fixes upstream, with
    <strong>{mergedCount} merged pull requests</strong> in projects like Microsoft PyRIT and OpenClaw.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:akshatshahh2003@gmail.com">
      <MailIcon class="size-4" />
      Contact me
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/akshatshahh">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/akshatshahh">
      <GithubIcon class="size-4" />
      GitHub
    </SocialPill>
    <SocialPill href="/resume" target="_self" rel="">
      Resume
    </SocialPill>
  </nav>
  <p class="mt-6 flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
    <span class="size-2 shrink-0 rounded-full bg-green-500" aria-hidden="true"></span>
    Open to Software Engineer, Backend and Full Stack roles · Open to relocation
  </p>
</div>
